{
  "name": "@matrixai/id",
  "version": "5.0.2",
  "author": "Roger Qiu",
  "description": "ID generation for JavaScript & TypeScript Applications",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MatrixAI/js-id.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/tsbuildinfo",
    "LICENSE.noble-hashes"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": "./dist/*"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
    "prepare": "tsc -p ./tsconfig.build.json",
    "build": "node ./scripts/build.mjs",
    "postversion": "npm install --package-lock-only --ignore-scripts --silent",
    "perf:bench": "id-perf",
    "tsx": "tsx",
    "test": "node ./scripts/test.mjs",
    "lint": "matrixai-lint --check",
    "lintfix": "matrixai-lint --fix"
  },
  "dependencies": {
    "multiformats": "14.0.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "5.1.0",
    "workerd": "1.20261019.1"
  }
}
