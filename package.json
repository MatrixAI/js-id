{
  "name": "@matrixai/id",
  "version": "4.0.0",
  "author": "Roger Qiu",
  "description": "ID generation for JavaScript & TypeScript Applications",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MatrixAI/js-id.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/tsbuildinfo"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": "./dist/*"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
    "prepare": "tsc -p ./tsconfig.build.json",
    "build": "shx rm -rf ./dist && tsc -p ./tsconfig.build.json",
    "postversion": "npm install --package-lock-only --ignore-scripts --silent",
    "tsx": "tsx",
    "test": "node ./scripts/test.mjs",
    "typecheck": "tsc -p ./tsconfig.json",
    "lint": "matrixai-lint",
    "lintfix": "matrixai-lint --fix",
    "check:package": "npm run build && node ./scripts/check-package.mjs",
    "check:portable": "node ./scripts/check-portable.mjs",
    "check:conformance": "npm run typecheck && npm test -- --runInBand && npm run check:package && npm run check:portable",
    "check": "npm run check:conformance && npm run lint"
  },
  "dependencies": {
    "multiformats": "^13.3.2",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@swc/core": "^1.3.62",
    "@swc/jest": "^0.2.29",
    "@types/jest": "^29.5.2",
    "@types/node": "^24.0.0",
    "jest": "^29.6.2",
    "jest-extended": "^4.0.0",
    "jest-junit": "^16.0.0",
    "shx": "^0.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
